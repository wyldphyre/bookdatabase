{
  "manifest_version": 3,
  "name": "Book Database",
  "version": "1.0.0",
  "description": "Add the Goodreads, Amazon or Kobo book page you're viewing to your Book Database.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Add to Book Database",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
